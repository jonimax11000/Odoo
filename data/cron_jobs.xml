<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════
             CRON 1: Sincronizar POS → cookast.forecast
             Cada 1 hora
        ═══════════════════════════════════════════════ -->
        <record id="ir_cron_sync_pos" model="ir.cron">
            <field name="name">Cookast: Sincronizar Ventas POS</field>
            <field name="model_id" ref="model_cookast_forecast"/>
            <field name="state">code</field>
            <field name="code">model._sync_pos_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- ═══════════════════════════════════════════════
             CRON 2: Sincronizar Compras → cookast.purchase.budget
             Cada 6 horas
        ═══════════════════════════════════════════════ -->
        <record id="ir_cron_sync_purchases" model="ir.cron">
            <field name="name">Cookast: Sincronizar Presupuestos de Compra</field>
            <field name="model_id" ref="model_cookast_purchase_budget"/>
            <field name="state">code</field>
            <field name="code">model._sync_purchase_orders()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
