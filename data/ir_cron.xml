<odoo>
    <record id="ir_cron_fetch_weather" model="ir.cron">
        <field name="name">Cookast: Obtener previsión meteorológica (Open-Meteo)</field>
        <field name="model_id" ref="model_cookast_weather_forecast"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_weather_forecast()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>