<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_shift_planning_user" model="res.groups">
        <field name="name">Shift Planning / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shift_planning_manager" model="res.groups">
        <field name="name">Shift Planning / Manager</field>
        <field name="implied_ids" eval="[(4, ref('shift_planner_community.group_shift_planning_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="shift_planning_slot_company_rule" model="ir.rule">
        <field name="name">Shift Planning Slot Company Rule</field>
        <field name="model_id" ref="model_shift_planning_slot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    
    <record id="shift_planning_slot_personal_rule" model="ir.rule">
        <field name="name">Shift Planning Slot Personal Rule</field>
        <field name="model_id" ref="model_shift_planning_slot"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_shift_planning_user'))]"/>
    </record>
    
    <record id="shift_planning_slot_manager_rule" model="ir.rule">
        <field name="name">Shift Planning Slot Manager Rule</field>
        <field name="model_id" ref="model_shift_planning_slot"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shift_planning_manager'))]"/>
    </record>
</odoo>
