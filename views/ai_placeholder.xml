<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         IA PLACEHOLDER
    ═══════════════════════════════════════════════ -->

    <record id="view_cookast_ai_placeholder_form" model="ir.ui.view">
        <field name="name">cookast.ai.placeholder.form</field>
        <field name="model">cookast.sync.log</field>
        <field name="arch" type="xml">
            <form string="Cookast AI">
                <sheet>
                    <div class="o_form_sheet_bg" style="text-align: center; padding: 60px 20px;">
                        <h1 style="font-size: 2.5rem; font-weight: 700; color: #875A7B;">
                            🤖 Próximamente: Cookast AI
                        </h1>
                        <p style="font-size: 1.1rem; color: #555; max-width: 600px; margin: 20px auto;">
                            Esta sección integrará capacidades de Inteligencia Artificial para predecir
                            la demanda, optimizar plantillas y sugerir decisiones de compra automáticamente.
                        </p>
                        <p style="color: #888;">
                            <em>Fase 2 — En desarrollo</em>
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cookast_ai_placeholder" model="ir.actions.act_window">
        <field name="name">Cookast AI</field>
        <field name="res_model">cookast.sync.log</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cookast_ai_placeholder_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_cookast_ai_item"
              name="Cookast AI"
              parent="menu_cookast_ai"
              action="action_cookast_ai_placeholder"
              sequence="10"/>
</odoo>
