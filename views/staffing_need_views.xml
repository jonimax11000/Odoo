<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form -->
    <record id="view_cookast_staffing_need_form" model="ir.ui.view">
        <field name="name">cookast.staffing.need.form</field>
        <field name="model">cookast.staffing.need</field>
        <field name="arch" type="xml">
            <form string="Necesidad de personal">
                <header>
                    <button name="action_generate_shift_plans" type="object" string="Generar asignaciones" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="forecast_id"/>
                            <field name="forecast_revenue" readonly="1"/>
                        </group>
                        <group>
                            <field name="stress_level" widget="badge" decoration-success="stress_level == 'low'" decoration-warning="stress_level == 'medium'" decoration-danger="stress_level == 'high' or stress_level == 'critical'"/>
                        </group>
                    </group>
                    <group string="Personal necesario">
                        <group>
                            <field name="total_persons"/>
                            <field name="responsible_qty"/>
                        </group>
                        <group>
                            <field name="senior_qty"/>
                            <field name="junior_qty"/>
                        </group>
                    </group>
                    <group string="Coste estimado">
                        <field name="estimated_cost" readonly="1"/>
                    </group>
                    <separator string="Asignaciones generadas"/>
                    <field name="shift_plan_ids">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="role"/>
                            <field name="planned_hours"/>
                            <field name="shift_cost"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_cookast_staffing_need_list" model="ir.ui.view">
        <field name="name">cookast.staffing.need.list</field>
        <field name="model">cookast.staffing.need</field>
        <field name="arch" type="xml">
            <list string="Necesidades de personal" decoration-warning="stress_level == 'high'" decoration-danger="stress_level == 'critical'">
                <field name="forecast_id"/>
                <field name="date"/>
                <field name="shift"/>
                <field name="location_id"/>
                <field name="forecast_revenue"/>
                <field name="total_persons"/>
                <field name="responsible_qty"/>
                <field name="senior_qty"/>
                <field name="junior_qty"/>
                <field name="estimated_cost" sum="Coste Total"/>
                <field name="stress_level" widget="badge" decoration-success="stress_level == 'low'" decoration-warning="stress_level == 'medium'" decoration-danger="stress_level == 'high' or stress_level == 'critical'"/>
            </list>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_cookast_staffing_need" model="ir.actions.act_window">
        <field name="name">Necesidades de personal</field>
        <field name="res_model">cookast.staffing.need</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_cookast_staffing_need" name="Necesidades de personal" parent="menu_cookast_personal" action="action_cookast_staffing_need" sequence="20"/>
</odoo>