<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         VISTAS: cookast.forecast  (Dashboard)
    ═══════════════════════════════════════════════ -->

    <!-- Graph: Previsión vs Real -->
    <record id="view_cookast_forecast_graph" model="ir.ui.view">
        <field name="name">cookast.forecast.graph</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <graph string="Previsión vs Real" type="bar" stacked="False">
                <!-- Eje X: agrupado por fecha (día). El usuario puede
                     cambiar a semana/mes desde el menú de la vista. -->
                <field name="date" type="row" interval="day"/>
                <!-- Eje de serie: un trazo por local. Cuando el usuario
                     filtra solo un local en el searchpanel, queda una sola
                     serie; si selecciona varios, aparece uno por local. -->
                <field name="local_id" type="col"/>
                <!-- Medida por defecto: previsión. El usuario puede añadir
                     actual_revenue, deviation o food_cost_pct desde "Medidas". -->
                <field name="forecast_revenue" type="measure"/>
                <field name="actual_revenue" type="measure"/>
                <field name="deviation" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: Detalle diario -->
    <record id="view_cookast_forecast_pivot" model="ir.ui.view">
        <field name="name">cookast.forecast.pivot</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <pivot string="Previsiones detalladas">
                <field name="date" type="row"/>
                <field name="shift" type="row"/>
                <!-- Columnas: un bloque por local activo en Cookast.
                     Al filtrar en el searchpanel se reduce dinámicamente. -->
                <field name="local_id" type="col"/>
                <field name="forecast_revenue" type="measure"/>
                <field name="actual_revenue" type="measure"/>
                <field name="deviation" type="measure"/>
                <field name="food_cost_pct" type="measure"/>
                <field name="total_purchases" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- List: detalle -->
    <record id="view_cookast_forecast_list" model="ir.ui.view">
        <field name="name">cookast.forecast.list</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <list string="Previsiones" decoration-danger="actual_revenue &gt; forecast_revenue">
                <field name="date"/>
                <field name="local_id"/>
                <field name="shift"/>
                <field name="forecast_revenue" sum="Total Previsión"/>
                <field name="actual_revenue" sum="Total Real"/>
                <field name="total_purchases" string="Compras" sum="Compras"/>
                <field name="food_cost_pct" widget="percentage"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cookast_forecast_form" model="ir.ui.view">
        <field name="name">cookast.forecast.form</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <form string="Previsión de turno">
                <header>
                    <button name="action_generate_shift_plans" type="object" string="Generar asignaciones" class="btn-primary" confirm="¿Generar asignaciones de personal para este turno?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="local_id"/>
                            <field name="shift"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="forecast_revenue"/>
                            <field name="actual_revenue"/>
                            <field name="deviation"/>
                            <field name="total_purchases" string="Compras del Día"/>
                            <field name="food_cost_pct" widget="percentage" string="Food Cost Diario"/>
                        </group>
                    </group>

                    <!-- Enlace a necesidad de personal -->
                    <group string="Personal necesario" colspan="4">
                        <field name="staffing_need_id" string="Necesidad de personal" options="{'no_create': True, 'no_open': False}">
                            <form string="Necesidad de personal">
                                <group>
                                    <group>
                                        <field name="total_persons"/>
                                        <field name="responsible_qty"/>
                                    </group>
                                    <group>
                                        <field name="senior_qty"/>
                                        <field name="junior_qty"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="estimated_cost"/>
                                    <field name="stress_level" widget="badge" decoration-success="stress_level == 'low'" decoration-warning="stress_level == 'medium'" decoration-danger="stress_level == 'high' or stress_level == 'critical'"/>
                                </group>
                                <separator string="Asignaciones generadas"/>
                                <field name="shift_plan_ids">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="role"/>
                                        <field name="planned_hours"/>
                                        <field name="shift_cost"/>
                                    </list>
                                </field>
                            </form>
                        </field>
                    </group>

                    <notebook>
                        <page string="Pedidos POS">
                            <field name="pos_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search con searchpanel dinámico de locales Cookast -->
    <record id="view_cookast_forecast_search" model="ir.ui.view">
        <field name="name">cookast.forecast.search</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <search string="Buscar previsiones">
                <field name="date"/>
                <field name="local_id"/>

                <!-- Filtros rápidos por turno -->
                <separator/>
                <filter string="Comida" name="filter_lunch"
                        domain="[('shift', '=', 'lunch')]"/>
                <filter string="Cena" name="filter_dinner"
                        domain="[('shift', '=', 'dinner')]"/>

                <!-- Filtros de fecha -->
                <separator/>
                <filter string="Esta semana" name="filter_this_week"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(weekday=0)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este mes" name="filter_this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>

                <!-- Agrupaciones -->
                <separator/>
                <filter string="Fecha" name="group_by_date"
                        context="{'group_by': 'date'}"/>
                <filter string="Local" name="group_by_local"
                        context="{'group_by': 'local_id'}"/>
                <filter string="Turno" name="group_by_shift"
                        context="{'group_by': 'shift'}"/>

                <!-- ══════════════════════════════════════════════════════
                     SEARCHPANEL DINÁMICO DE LOCALES
                     Muestra todos los locales de la franquicia.
                     → select="multi" permite seleccionar uno, varios o todos.
                     → enable_counters muestra cuántas previsiones hay por local.
                ══════════════════════════════════════════════════════ -->
                <searchpanel>
                    <field name="local_id"
                           icon="fa-building"
                           enable_counters="1"
                           select="multi"
                           string="Locales"/>
                    <field name="shift"
                           icon="fa-clock-o"
                           enable_counters="1"
                           select="multi"
                           string="Turno"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Log de sincronizaciones: list -->
    <record id="view_cookast_sync_log_list" model="ir.ui.view">
        <field name="name">cookast.sync.log.list</field>
        <field name="model">cookast.sync.log</field>
        <field name="arch" type="xml">
            <list string="Log de sincronizaciones" decoration-danger="status=='error'">
                <field name="sync_date"/>
                <field name="model_synced"/>
                <field name="records_processed"/>
                <field name="status"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <!-- ═══════ Acciones ══════════════════════════════════════════════════ -->
    <record id="action_cookast_forecast_server" model="ir.actions.server">
        <field name="name">Previsiones</field>
        <field name="model_id" ref="model_cookast_forecast"/>
        <field name="state">code</field>
        <field name="code">
# 1. Sincronizar en tiempo real (POS y Ventas)
env['cookast.forecast']._sync_pos_orders()

# 2. Recalcular forecast_revenue para registros que lo necesiten
forecasts_to_compute = env['cookast.forecast'].search([('forecast_revenue', '=', 0)])
if forecasts_to_compute:
    forecasts_to_compute._compute_forecast_revenue()

# 3. Devolver la acción original para abrir las vistas
action = {
    'name': 'Previsiones',
    'type': 'ir.actions.act_window',
    'res_model': 'cookast.forecast',
    'view_mode': 'graph,pivot,list,form',
}
        </field>
    </record>

    <record id="action_cookast_sync_log" model="ir.actions.act_window">
        <field name="name">Log de Sincronizaciones</field>
        <field name="res_model">cookast.sync.log</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Acción para abrir el staffing_need asociado al forecast -->
    <record id="action_cookast_staffing_need_open" model="ir.actions.act_window">
        <field name="name">Personal necesario</field>
        <field name="res_model">cookast.staffing.need</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ═══════ Entradas de menú ══════════════════════════════════════════ -->
    <menuitem id="menu_cookast_forecast" name="Previsiones" parent="menu_cookast_dashboard" action="action_cookast_forecast_server" sequence="10"/>

    <menuitem id="menu_cookast_sync_log" name="Log de Sincronizaciones" parent="menu_cookast_dashboard" action="action_cookast_sync_log" sequence="20"/>
</odoo>
