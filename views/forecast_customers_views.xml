<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         VISTAS: expected_customers en cookast.forecast
         Sin dependencia de IA.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- 1. Formulario: botón algorítmico + campo editable -->
    <record id="view_cookast_forecast_form_customers" model="ir.ui.view">
        <field name="name">cookast.forecast.form.customers</field>
        <field name="model">cookast.forecast</field>
        <field name="inherit_id" ref="cookast.view_cookast_forecast_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compute_customers"
                        string="Calcular Clientes"
                        type="object"
                        class="btn-secondary"
                        title="Calcula el nº de clientes con el historial POS (sin IA)" />
            </xpath>
            <!-- Campo editable debajo de forecast_revenue -->
            <xpath expr="//field[@name='forecast_revenue']" position="after">
                <field name="expected_customers" />
            </xpath>
        </field>
    </record>

    <!-- 2. Lista: columna de clientes esperados + sumatorio -->
    <record id="view_cookast_forecast_list_customers" model="ir.ui.view">
        <field name="name">cookast.forecast.list.customers</field>
        <field name="model">cookast.forecast</field>
        <field name="inherit_id" ref="cookast.view_cookast_forecast_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='forecast_revenue']" position="after">
                <field name="expected_customers" sum="Total Clientes Estimados" />
            </xpath>
        </field>
    </record>

    <!-- 3. Kanban: tarjeta con datos clave del turno -->
    <record id="view_cookast_forecast_kanban" model="ir.ui.view">
        <field name="name">cookast.forecast.kanban</field>
        <field name="model">cookast.forecast</field>
        <field name="arch" type="xml">
            <kanban default_group_by="date">
                <field name="date"/>
                <field name="local_id"/>
                <field name="shift"/>
                <field name="forecast_revenue"/>
                <field name="actual_revenue"/>
                <field name="expected_customers"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <strong class="o_kanban_record_title">
                                    <field name="local_id"/>
                                </strong>
                                <span class="badge rounded-pill text-bg-primary ms-1">
                                    <field name="shift"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-euro me-1"/>
                                    <strong>Previsión: </strong>
                                    <field name="forecast_revenue"/>
                                </div>
                                <div>
                                    <i class="fa fa-users me-1"/>
                                    <strong>Clientes estimados: </strong>
                                    <field name="expected_customers"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 4. Habilitar la vista Kanban en la acción de Detalle de Previsiones -->
    <record id="cookast.action_cookast_forecast_detail" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,graph,pivot,form</field>
    </record>

</odoo>
