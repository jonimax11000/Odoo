<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         cookast_ai – extensión de vistas de previsión con botón de IA.
         El campo expected_customers y las vistas base ya están en cookast.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Formulario: añadir botón "Calcular con IA" y campo ai_forecast_revenue -->
    <record id="view_cookast_forecast_form_ai" model="ir.ui.view">
        <field name="name">cookast.forecast.form.ai</field>
        <field name="model">cookast.forecast</field>
        <field name="inherit_id" ref="cookast.view_cookast_forecast_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_forecast"
                        string="Previsión IA (€)"
                        type="object"
                        class="btn-secondary" />
                <button name="action_ai_predict_customers"
                        string="Clientes (IA)"
                        type="object"
                        class="btn-secondary"
                        title="Refina la estimación algorítmica con inteligencia artificial" />
            </xpath>
            <xpath expr="//field[@name='forecast_revenue']" position="after">
                <field name="ai_forecast_revenue" />
            </xpath>
        </field>
    </record>

    <!-- Lista: añadir columna de Previsión IA -->
    <record id="view_cookast_forecast_list_ai" model="ir.ui.view">
        <field name="name">cookast.forecast.list.ai</field>
        <field name="model">cookast.forecast</field>
        <field name="inherit_id" ref="cookast.view_cookast_forecast_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='forecast_revenue']" position="after">
                <field name="ai_forecast_revenue" string="Previsión IA (€)" sum="Total Previsión IA" />
            </xpath>
        </field>
    </record>

</odoo>