<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cookast_ai_config_form" model="ir.ui.view">
        <field name="name">cookast.ai.config.form</field>
        <field name="model">cookast.ai.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de IA">
                <header>
                    <button name="action_test_connection" string="Probar conexión" type="object"
                        class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la configuración" />
                        </h1>
                    </div>
                    <group string="Conexión Ollama">
                        <field name="ollama_endpoint" />
                        <field name="model_name" />
                        <field name="temperature" />
                        <field name="max_tokens" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cookast_ai_config_list" model="ir.ui.view">
        <field name="name">cookast.ai.config.list</field>
        <field name="model">cookast.ai.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones de IA">
                <header>
                    <button name="action_test_connection" string="Probar conexión" type="object"
                        class="btn-primary" />
                </header>
                <field name="name" />
                <field name="ollama_endpoint" />
                <field name="model_name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="action_cookast_ai_config" model="ir.actions.act_window">
        <field name="name">Configuración de IA</field>
        <field name="res_model">cookast.ai.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'create': True}</field>  <!-- Permite crear si no hay ninguna -->
    </record>

    <menuitem id="menu_cookast_ai_config"
        name="Configuración IA"
        parent="cookast.menu_cookast_ai"
        action="action_cookast_ai_config"
        sequence="10" />
</odoo>