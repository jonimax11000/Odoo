<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_shift_template" model="ir.actions.act_window">
        <field name="name">Shift Templates</field>
        <field name="res_model">shift.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shift_planning_config" name="Configuration" parent="menu_shift_planning_root" sequence="100"/>
    <menuitem id="menu_shift_template" name="Shift Templates" parent="menu_shift_planning_config" action="action_shift_template" sequence="10"/>

    <record id="view_shift_template_tree" model="ir.ui.view">
        <field name="name">shift.template.tree</field>
        <field name="model">shift.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="planned_hours" widget="float_time"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="view_shift_template_form" model="ir.ui.view">
        <field name="name">shift.template.form</field>
        <field name="model">shift.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="planned_hours" widget="float_time"/>
                        </group>
                        <group>
                            <field name="job_id"/>
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
