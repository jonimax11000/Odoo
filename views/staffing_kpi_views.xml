<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del wizard de filtros -->
    <record id="action_cookast_staffing_kpi_wizard" model="ir.actions.act_window">
        <field name="name">Filtrar Turnos</field>
        <field name="res_model">cookast.staffing.kpi.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server Action para abrir el Kanban de Personal -->
    <record id="action_cookast_staffing_kpi_server_action" model="ir.actions.server">
        <field name="name">Personal – Dashboard KPI</field>
        <field name="model_id" ref="model_cookast_staffing_kpi"/>
        <field name="state">code</field>
        <field name="code">
# Regenerar KPIs con todos los datos (sin filtros por defecto) env['cookast.staffing.kpi']._refresh_kpis(domain=[])

# Abrir la vista kanban de KPIs
action = {
    'name': 'Necesidades de personal',
    'type': 'ir.actions.act_window',
    'res_model': 'cookast.staffing.kpi',
    'view_mode': 'kanban',
    'views': [(False, 'kanban')],
    'target': 'current',
    'context': {'create': False, 'edit': False},
}
        </field>
    </record>

    <!-- ══════ 3. Vistas ══════ -->

    <record id="view_cookast_staffing_kpi_kanban" model="ir.ui.view">
        <field name="name">cookast.staffing.kpi.kanban</field>
        <field name="model">cookast.staffing.kpi</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false" class="o_cookast_kpi_kanban">
                <field name="kpi_type"/>
                <field name="title"/>
                <field name="subtitle"/>
                <field name="value"/>
                <field name="value_char"/>
                <field name="icon"/>
                <field name="color_class"/>

                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_kpi_card #{record.color_class.value}">
                            <div class="o_kpi_icon">
                                <i t-attf-class="fa #{record.icon.value} fa-2x"/>
                            </div>
                            <div class="o_kpi_body">
                                <div class="o_kpi_value">
                                    <t t-esc="record.value_char.value"/>
                                </div>
                                <div class="o_kpi_title">
                                    <t t-esc="record.title.value"/>
                                </div>
                                <div class="o_kpi_subtitle">
                                    <t t-esc="record.subtitle.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cookast_staffing_kpi_search" model="ir.ui.view">
        <field name="name">cookast.staffing.kpi.search</field>
        <field name="model">cookast.staffing.kpi</field>
        <field name="arch" type="xml">
            <search string="KPIs de Personal"/>
        </field>
    </record>

    <record id="view_cookast_staffing_kpi_wizard_form" model="ir.ui.view">
        <field name="name">cookast.staffing.kpi.wizard.form</field>
        <field name="model">cookast.staffing.kpi.wizard</field>
        <field name="arch" type="xml">
            <form string="Filtrar Turnos">
                <sheet>
                    <div class="oe_title">
                        <h2>Filtrar datos del dashboard de personal</h2>
                        <p class="text-muted">
                            Selecciona el rango de fechas y los locales para actualizar
                            las tarjetas KPI.
                        </p>
                    </div>
                    <group>
                        <group string="Rango de fechas">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Locales">
                            <field name="local_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Todos los locales"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_filters" type="object" string="Aplicar filtros" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ══════ 4. Menús dentro de Personal ══════ -->
    <!-- Estos menús van dentro de la carpeta Personal (definida en staffing_need_views.xml) -->
    <menuitem id="menu_cookast_personal_kpi_folder" name="Personal" parent="menu_cookast_personal" sequence="15"/>

    <menuitem id="menu_cookast_staffing_kpi" name="Dashboard Personal" parent="menu_cookast_personal_kpi_folder" action="action_cookast_staffing_kpi_server_action" sequence="15"/>

    <menuitem id="menu_cookast_staffing_kpi_filter" name="Filtros Personal" parent="menu_cookast_personal_kpi_folder" action="action_cookast_staffing_kpi_wizard" sequence="16"/>
</odoo>