<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACCIÓN: Lista de Materiales (redirige a mrp.bom nativo)
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="action_cookast_mrp_bom" model="ir.actions.act_window">
        <field name="name">Listas de Materiales</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type': 'phantom'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera Lista de Materiales
            </p>
            <p>
                Define la composición de cada producto: qué materias primas
                o componentes necesita y en qué cantidad.
                <br/>
                Esto sirve para cualquier tipo de producto: platos de restaurante,
                monturas de gafas, kits, etc.
            </p>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         VISTAS DE NECESIDADES DE MATERIA PRIMA (cookast.material.need)
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── LISTA ─────────────────────────────────────────────────────── -->
    <record id="view_cookast_material_need_list" model="ir.ui.view">
        <field name="name">cookast.material.need.list</field>
        <field name="model">cookast.material.need</field>
        <field name="arch" type="xml">
            <list string="Necesidades de Materia Prima"
                  decoration-danger="stock_status == 'out'"
                  decoration-warning="stock_status == 'low'"
                  create="false" edit="false" delete="false">
                <header>
                    <button name="action_create_purchase_order"
                            string="Crear Pedido de Compra"
                            type="object"
                            class="btn-primary"/>
                </header>
                <field name="local_id"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="qty_available"/>
                <field name="total_needed"/>
                <field name="qty_to_purchase"
                       decoration-danger="qty_to_purchase &gt; 0"/>
                <field name="unit_cost"/>
                <field name="purchase_cost"/>
                <field name="bom_count"/>
                <field name="stock_status" widget="badge"
                       decoration-success="stock_status == 'ok'"
                       decoration-warning="stock_status == 'low'"
                       decoration-danger="stock_status == 'out'"/>
            </list>
        </field>
    </record>

    <!-- ── BÚSQUEDA ──────────────────────────────────────────────────── -->
    <record id="view_cookast_material_need_search" model="ir.ui.view">
        <field name="name">cookast.material.need.search</field>
        <field name="model">cookast.material.need</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <separator/>
                <filter name="filter_out_of_stock" string="Sin Stock"
                        domain="[('stock_status', '=', 'out')]"/>
                <filter name="filter_low_stock" string="Stock Bajo"
                        domain="[('stock_status', 'in', ['out', 'low'])]"/>
                <filter name="filter_needs_purchase" string="Necesita Compra"
                        domain="[('qty_to_purchase', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_status" string="Agrupar por Estado Stock"
                        context="{'group_by': 'stock_status'}"/>
                <filter name="group_local" string="Agrupar por Local"
                        context="{'group_by': 'local_id'}"/>
                <searchpanel>
                    <field name="local_id" icon="fa-building" enable_counters="1" select="multi" string="Locales"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ── ACCIÓN ────────────────────────────────────────────────────── -->
    <record id="action_cookast_material_need" model="ir.actions.act_window">
        <field name="name">Necesidades de Materia Prima</field>
        <field name="res_model">cookast.material.need</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_cookast_material_need_search"/>
        <field name="context">{'search_default_filter_low_stock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Todo el stock está cubierto!
            </p>
            <p>
                Aquí verás un resumen de las materias primas que necesitas
                comprar según las Listas de Materiales definidas y el stock actual.
            </p>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         MENÚS (bajo Cookast > Compras)
    ═══════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_cookast_mrp_bom"
              name="Listas de Materiales"
              parent="menu_cookast_compras"
              action="action_cookast_mrp_bom"
              sequence="20"/>

    <menuitem id="menu_cookast_material_need"
              name="Necesidades de Materia Prima"
              parent="menu_cookast_compras"
              action="action_cookast_material_need"
              sequence="30"/>

</odoo>
