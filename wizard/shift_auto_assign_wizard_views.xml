<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_shift_auto_assign_wizard" model="ir.actions.act_window">
        <field name="name">Auto-Planify</field>
        <field name="res_model">shift.auto.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_shift_auto_assign" name="Auto-Planify" parent="menu_shift_planning_main" action="action_shift_auto_assign_wizard" sequence="30"/>

    <record id="view_shift_auto_assign_wizard_form" model="ir.ui.view">
        <field name="name">shift.auto.assign.wizard.form</field>
        <field name="model">shift.auto.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p class="oe_grey">
                        This wizard will automatically assign employees to unassigned shifts based on their availability, skills, and workload equity.
                    </p>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Candidates">
                        <field name="employee_ids" widget="many2many_tags" placeholder="Leave empty to consider all employees..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_auto_assign" type="object" string="Auto-Planify" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
