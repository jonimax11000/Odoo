<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_shift_planning_wizard" model="ir.actions.act_window">
        <field name="name">Generate Shifts</field>
        <field name="res_model">shift.planning.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Adding a button to the schedule menu or form -->
    <menuitem id="menu_shift_planning_wizard" name="Generate Shifts" parent="menu_shift_planning_main" action="action_shift_planning_wizard" sequence="20"/>

    <record id="view_shift_planning_wizard_form" model="ir.ui.view">
        <field name="name">shift.planning.wizard.form</field>
        <field name="model">shift.planning.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Recurrence (Days of week)">
                        <group>
                            <field name="repeat_mon"/>
                            <field name="repeat_tue"/>
                            <field name="repeat_wed"/>
                            <field name="repeat_thu"/>
                        </group>
                        <group>
                            <field name="repeat_fri"/>
                            <field name="repeat_sat"/>
                            <field name="repeat_sun"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_shifts" type="object" string="Generate" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
